<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <script defer src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="/">CSE 340 Service Network</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="mainNavbar">
                
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/organizations">Organizations</a></li>
                    <li class="nav-item"><a class="nav-link" href="/projects">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="/categories">Categories</a></li>
                </ul>

                <div class="d-none d-lg-block vr mx-4 text-secondary opacity-25"></div>
                <hr class="d-lg-none text-secondary opacity-25 my-3">

                <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-center">
                    <% if (isLoggedIn) { %>
                        <a class="btn btn-sm btn-outline-secondary fw-medium px-4 w-100" href="/logout">
                            Logout
                        </a>
                    <% } else { %>
                        <a class="btn btn-sm btn-outline-primary fw-medium px-4 w-100" href="/login">
                            Login
                        </a>
                        <a class="btn btn-sm btn-primary fw-medium px-4 shadow-sm w-100" href="/register">
                            Register
                        </a>
                    <% } %>
                </div>

            </div>
        </div>
    </nav>
    
    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <% messages[type].forEach(msg => { %>
                
                <% 
                    let textColor = 'text-primary'; 
                    if (type === 'success') textColor = 'text-success'; 
                    if (type === 'error' || type === 'danger') textColor = 'text-danger'; 
                %>

                <p class="text-center fw-medium mb-4 mt-3 <%= textColor %>">
                    <%= msg %>
                </p>

            <% }); %>
        <% } %>
    <% }); %>
