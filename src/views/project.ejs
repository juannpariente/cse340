<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.name %></h2>

    <p>Description: <%= projectDetails.description %></p>
    <p>Date: <%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p>Location: <%= projectDetails.location %></p>

    <p><a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
</main>
<%- include('partials/footer') %>