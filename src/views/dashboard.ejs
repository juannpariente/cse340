<%- include('partials/header') %>
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-10 col-md-8 col-lg-6">
            
            <div class="card border-0 shadow-sm p-4 p-md-5">
                
                <h1 class="fw-bold h2 mb-1 text-center"><%= title %></h1>
                <h2 class="h5 text-body-secondary text-center mb-4">Dashboard</h2>

                <div class="bg-light p-3 rounded-3">
                    <p class="mb-2 fw-medium text-secondary">Name: <span class="text-dark"><%= name %></span></p>
                    <p class="mb-0 fw-medium text-secondary">Username: <span class="text-dark"><%= email %></span></p>
                </div>

                <% if (user && user.role_name === 'admin') { %>
                    <div class="mt-4">
                        <a href="/users" class="btn btn-primary w-100 fw-medium shadow-sm">
                            View Users
                        </a>
                    </div>
                <% } %>

                <hr class="my-4 text-secondary opacity-25">

                <h3 class="h5 fw-bold mb-3 text-dark">My volunteering projects</h3>

                <% if (projects.length === 0) { %>
                    <div class="alert alert-light text-secondary text-center border mb-0" role="alert">
                        You are not volunteering for any projects yet.
                    </div>
                <% } else { %>
                    <ul class="list-group list-group-flush border-top border-bottom">
                        <% projects.forEach(project => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <span class="fw-medium"><%= project.title %></span>
                                
                                <form method="POST" action="/project/<%= project.project_id %>/unvolunteer" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-medium">
                                        Remove
                                    </button>
                                </form>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>

            </div>
            
        </div>
    </div>
</main>
<%- include('partials/footer') %>