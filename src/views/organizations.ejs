<%- include('partials/header') %>
<main class="container py-5">
    <div class="page-heading mb-4">
        <h1 class="fw-bold"><%= title %></h1>
        <p class="text-body-secondary mb-0">Here are a few of our partner organizations.</p>
    </div>

    <div class="row g-4">
        <% organizations.forEach(organization => { %>
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm border-0 organization-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img class="organization-logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                            <h2 class="h5 card-title mb-0"><%= organization.name %></h2>
                        </div>
                        <p class="card-text text-body-secondary small mb-4"><%= organization.contact_email %></p>
                        <a class="btn btn-primary mt-auto" href="/organization/<%= organization.organization_id %>">View organization</a>
                    </div>
                </article>
            </div>
        <% }); %>
    </div>
    <div class="mt-5 text-center">
        <% if (user && user.role_name === 'admin') { %>
            <a href="/new-organization" class="btn btn-primary btn-lg" style="border-radius: 0.5rem;">
                Add a New Organization
            </a>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>
