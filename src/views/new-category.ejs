<%- include('partials/header') %>
<main class="container py-5">
    
    <div class="page-heading mx-auto text-center mb-5">
        <h1 class="fw-bold"><%= title %></h1>
        <p class="text-body-secondary mb-0">Add a new category to organize your service projects.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5"> <div class="card border-0 shadow-sm p-4 p-md-5">
                <form action="/new-category" method="POST">
                    
                    <div class="mb-4">
                        <label for="name" class="form-label fw-semibold">Category Name</label>
                        <input 
                            type="text" 
                            class="form-control" 
                            id="name" 
                            name="name" 
                            placeholder="e.g., Community Support" 
                            required 
                            maxlength="100"
                        />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg" style="border-radius: 0.5rem;">Create Category</button>
                        <a href="/categories" class="btn btn-light" style="border-radius: 0.5rem;">Cancel</a>
                    </div>
                    
                </form>
            </div>
        </div>
    </div>

</main>
<%- include('partials/footer') %>