<%- include('partials/header') %>
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-10 col-md-6 col-lg-5">
            
            <div class="card border-0 shadow-sm p-4 p-md-5">
                
                <h1 class="fw-bold h2 mb-4 text-center"><%= title %></h1>

                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-medium text-secondary">Email (Username)</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            required
                        />
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-medium text-secondary">Password</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            required
                        />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-medium shadow-sm">Login</button>
                </form>

            </div>
            
        </div>
    </div>
</main>
<%- include('partials/footer') %>