<%- include('partials/header') %>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="card border-0 shadow-sm overflow-hidden">
                
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 px-md-5 d-flex justify-content-between align-items-center">
                    <h1 class="fw-bold h3 mb-0"><%= title %></h1>
                    <a href="/dashboard" class="btn btn-sm btn-outline-secondary fw-medium">
                        &larr; Back
                    </a>
                </div>

                <div class="card-body p-4 p-md-5 pt-3">
                    <div class="table-responsive">
                        
                        <table class="table table-hover align-middle mb-0">
                            
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-semibold text-secondary py-3 rounded-start border-0">Name</th>
                                    <th class="fw-semibold text-secondary py-3 border-0">Email</th>
                                    <th class="fw-semibold text-secondary py-3 rounded-end border-0">Role</th>
                                </tr>
                            </thead>

                            <tbody class="border-top-0">
                                <% users.forEach(user => { %>
                                    <tr>
                                        <td class="py-3 fw-medium text-dark border-bottom border-light">
                                            <%= user.name %>
                                        </td>
                                        
                                        <td class="py-3 text-secondary border-bottom border-light">
                                            <%= user.email %>
                                        </td>
                                        
                                        <td class="py-3 border-bottom border-light">
                                            <span class="badge <%= user.role_name === 'admin' ? 'bg-primary' : 'bg-secondary bg-opacity-75' %> rounded-pill px-3 fw-medium">
                                                <%= user.role_name %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>

                        </table>

                    </div>
                </div>

            </div>

        </div>
    </div>
</main>

<%- include('partials/footer') %>