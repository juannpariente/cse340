<%- include('partials/header') %>
<main class="container py-5">
    <div class="page-heading mb-4">
        <h1 class="fw-bold"><%= title %></h1>
        <p class="text-body-secondary mb-0">Service projects in this category.</p>
    </div>

    <h2 class="h4 mb-3">Service Projects</h2>
    <div class="list-group shadow-sm">
        <% projects.forEach(project => { %>
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="/project/<%= project.project_id %>">
                <span class="fw-medium"><%= project.title %></span>
                <span aria-hidden="true">&rsaquo;</span>
            </a>
        <% }) %>
    </div>

    <div class="text-center mt-5 mb-2">
        <a href="/new-organization" class="btn btn-primary px-4 py-2 shadow-sm" style="border-radius: 0.5rem;">
            Add a new organization
        </a>
    </div>
</main>
<%- include('partials/footer') %>
