<%- include('partials/header') %>
<main class="container py-5">
    <article class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4 p-md-5">
            <p class="text-body-secondary mb-1"><%= title %></p>
            <h1 class="fw-bold mb-3"><%= projectDetails.name %></h1>
            <p class="lead text-body-secondary mb-4"><%= projectDetails.description %></p>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <div class="info-box">
                        <span class="info-label">Date</span>
                        <span class="info-value"><%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="info-box">
                        <span class="info-label">Location</span>
                        <span class="info-value"><%= projectDetails.location %></span>
                    </div>
                </div>
            </div>

            <p class="mb-0">Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
        </div>
    </article>

    <h2 class="h4 mb-3">Categories</h2>
    <div class="d-flex flex-wrap gap-2">
        <% categories.forEach(category => { %>
            <a class="btn btn-outline-primary" href="/category/<%= category.category_id %>"><%= category.name %></a>
        <% }) %>
    </div>
</main>
<%- include('partials/footer') %>
