<%- include('../partials/header') %>
<main class="container py-5">
    <section class="card border-0 shadow-sm mx-auto error-card">
        <div class="card-body p-4 p-md-5">
            <h1 class="fw-bold mb-3">Something Went Wrong</h1>
            <p class="text-body-secondary">We are experiencing technical difficulties. Our team has been notified and is working to fix the issue.</p>
            <a class="btn btn-primary mb-4" href="/">Return to homepage</a>

            <% if (NODE_ENV === 'development') { %>
                <details open class="mt-3">
                    <summary>Error Details (Development Only)</summary>
                    <pre><%= error %></pre>
                    <pre><%= stack %></pre>
                </details>
            <% } %>
        </div>
    </section>
</main>
<%- include('../partials/footer') %>
