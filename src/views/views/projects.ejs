<%- include('partials/header') %>
<main class="container py-5">
    <div class="page-heading mb-4">
        <h1 class="fw-bold"><%= title %></h1>
        <p class="text-body-secondary mb-0">Upcoming service projects.</p>
    </div>

    <div class="row g-4">
        <% upcomingProjects.forEach(project => { %>
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <p class="text-body-secondary small mb-2"><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                        <h2 class="h5 card-title mb-3"><%= project.title %></h2>
                        <p class="card-text text-body-secondary small mb-4">Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                        <a class="btn btn-primary mt-auto" href="/project/<%= project.project_id %>">View project</a>
                    </div>
                </article>
            </div>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>
