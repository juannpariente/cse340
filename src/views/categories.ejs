<%- include('partials/header') %>
<main class="container py-5">
    <div class="page-heading mb-4">
        <h1 class="fw-bold"><%= title %></h1>
        <p class="text-body-secondary mb-0">Browse service opportunities by category.</p>
    </div>

    <div class="list-group shadow-sm">
        <% categories.forEach(category => { %>
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="/category/<%= category.category_id %>">
                <span class="fw-medium"><%= category.name %></span>
                <span aria-hidden="true">&rsaquo;</span>
            </a>
        <% }); %>
    </div>
    <div class="mt-5 text-center">
        <a href="/new-category" class="btn btn-primary btn-lg" style="border-radius: 0.5rem;">
            Add a New Category
        </a>
    </div>
</main>
<%- include('partials/footer') %>
