<%- include('partials/header') %>
<main class="container py-5">
    <section class="card border-0 shadow-sm mb-5">
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-organization/<%= organizationDetails.organization_id %>" 
               class="btn btn-outline-primary btn-sm position-absolute top-0 end-0 mt-3 me-3 mt-md-4 me-md-4" 
               style="border-radius: 0.5rem; z-index: 10;">
                Edit Organization
            </a>
        <% } %>
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                <img class="organization-logo organization-logo-lg" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
                <div>
                    <p class="text-body-secondary mb-1"><%= title %></p>
                    <h1 class="fw-bold mb-3"><%= organizationDetails.name %></h1>
                    <p class="lead text-body-secondary mb-0"><%= organizationDetails.description %></p>
                </div>
            </div>
        </div>
    </section>

    <h2 class="h4 mb-3">Service Projects</h2>
    <div class="list-group shadow-sm">
        <% projects.forEach(project => { %>
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="/project/<%= project.project_id %>">
                <span class="fw-medium"><%= project.title %></span>
                <span aria-hidden="true">&rsaquo;</span>
            </a>
        <% }) %>
    </div>
</main>
<%- include('partials/footer') %>
